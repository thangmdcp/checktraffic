# Đổi tên file này thành .env nếu muốn tùy chỉnh (tất cả đều TÙY CHỌN).

# Thư mục lưu profile trình duyệt (chứa cookie cf_clearance sau khi giải Turnstile).
# Mặc định: ./browser_profile
# TRAFFICCV_PROFILE_DIR=

# Chạy trình duyệt ẩn (1) hay hiện cửa sổ (0). Để giải Turnstile bằng tay cần 0.
# TRAFFICCV_HEADLESS=0

# Proxy (nếu cần né chặn theo IP), ví dụ: http://user:pass@host:port
# TRAFFICCV_PROXY=

# Supabase: app local dùng service-role để ghi dữ liệu.
# Tuyệt đối không đưa SUPABASE_SERVICE_ROLE_KEY vào JavaScript/web bên ngoài.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Website bên ngoài dùng anon key và chỉ có quyền SELECT theo supabase_schema.sql.
# SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
